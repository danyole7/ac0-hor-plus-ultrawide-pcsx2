gametitle=Ace Combat Zero: The Belkan War [SLUS-21346] (NTSC-U)

// Target: 3840x1600 = 2.4:1

[Ultrawide Hor+ 2.4:1 - 3840x1600]
author=danyole7
description=Corrects 3D projection and vertical FOV for a 2.4:1 display; includes scripted cutscene Hor+ correction. Fully restart the game after updating.

// Preserve nemesis2000's established 16:9 camera calibration.
// 003FA350 is loaded into f21 at 001D35E0 and copied into f24. These feed
// camera fields +10C/+114 at 001D3674/001D3678 in the inspected setup path.
// Value: 428.4449157714844
patch=1,EE,003FA350,word,43D638F3

// 003FA354 is loaded into f25 at 001D35E4; stored to camera field +110 at
// 001D367C. Value: 470.9024963378906. Keep the two camera baselines together.
patch=1,EE,003FA354,word,43EB7385

// Virtual screen width.
// Constructor 00339400 loads this at 00339468 and stores context+0 at
// 00339478. Original 44200000 = 640.0; proposed 44580000 = 864.0.
// New width = 640 * ((3840/1600)/(16/9)) = 864; equivalently 360 * 2.4.
// Update 00105698 derives X scale = rasterWidth / virtualWidth at 00105704,
// storing context+198. Thus X scale becomes 640/864 = 20/27 of baseline.
// Intended result: wider horizontal FOV, unchanged vertical.
patch=1,EE,003F75AC,word,44580000

// Additional view/replay width, also originally 640.0. Loaded at 002A72D4
// and 002A7710, then passed as f12 to setter 00105550 (stores context+0).
// The 16:9 branch selects height 360.0 at 003FD6DC; the 4:3 branch selects
// 480.0 at 003FD6EC.
patch=1,EE,003FD6D8,word,44580000

// SPECIAL THANKS:
// PCSX2's bundled 16:9 patch by nemesis2000 supplies the
// two camera calibration words. Dipshet's updated Zero ultrawide PCSX2 forum post points
// to the two virtual-width constants; their load/store and scale calculations
// were checked in the tested SLUS-21346 ISO. The published 860.0 width is replaced by
// exact 864.0 for this 2.4:1 target.

[De-stretch UI - Radio subtitles only - 2.4:1]
author=danyole7
description=De-stretch mission radio name/subtitles only; enable alongside Hor+ patch and fully restart the game after updating.
